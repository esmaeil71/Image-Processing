# MedImage Studio — copy to .env and adjust

# Database
POSTGRES_USER=medimage
POSTGRES_PASSWORD=medimage_dev_change_me
POSTGRES_DB=medimage

# Auth (use long random string in production)
JWT_SECRET=change_me_to_a_long_random_secret

# Orthanc (DICOM archive + DICOMweb)
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=orthanc_dev_change_me

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=miniokey
MINIO_ROOT_SECRET=miniosecret_dev_change_me
S3_BUCKET=medimage-storage

# Backend
CORS_ORIGINS=http://localhost:5173
UPLOAD_MAX_BYTES=5368709120

# Frontend (browser reaches these URLs)
VITE_API_URL=http://localhost:8000
VITE_ORTHANC_DICOMWEB=http://localhost:8042/dicom-web

# AI worker — optional path to MONAI bundle on host (mounted in worker as needed)
# Do NOT auto-download weights; place files under ./models and mount or set MODEL_WEIGHTS_DIR
MONAI_BUNDLE_PATH=

TORCH_NUM_THREADS=4

# Default admin (created on first backend start if set)
ADMIN_EMAIL=admin@medimage.local
ADMIN_PASSWORD=ChangeMeAdmin123!
